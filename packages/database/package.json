{
  "name": "@blackwall/database",
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect.ts",
    "./migrate": "./src/migrate.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "bun run --bun tsc --noEmit",
    "db:generate": "bun --env-file=../../.env run --bun drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env run --bun drizzle-kit migrate",
    "db:drop": "bun --env-file=../../.env run src/drop.ts",
    "e2e:prepare": "bun run src/e2e/prepare.ts"
  },
  "dependencies": {
    "@blackwall/shared": "workspace:*",
    "@faker-js/faker": "^9.6.0",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "4.0.0-rc.117",
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "1.0.0-rc.5-5935859"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.18.0",
    "better-auth": "^1.4.17"
  }
}
